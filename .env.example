NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PATH=./data/tensorhub.db
TRUST_PROXY=1
APP_ORIGIN=https://events.example.com
ALCOHOL_THRESHOLD=0.02
ATTESTATION_MAX_AGE_MS=300000
# Optional default secret for simulator devices; use unique secrets in production.
INTERLOCK_ATTESTATION_SECRET=replace-with-a-random-device-secret
# Set these only in the deployment secret manager to provision the Technical Team account.
TECHNICAL_TEAM_EMAIL=team@example.com
TECHNICAL_TEAM_PASSWORD=replace-with-a-unique-12-character-password

# FastAPI service (services/api); use a 32+ character secret in production.
DATABASE_URL=sqlite:///./data/interlock.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
DEVICE_ENCRYPTION_KEY=generate-a-fernet-key-and-store-it-in-your-secret-manager
